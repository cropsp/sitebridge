---
import '../styles/global.css';
import SEOHelmet from '../components/SEOHelmet.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'article' | 'product';
  publishDate?: Date;
}

const { title, description, image, type, publishDate } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEOHelmet
      title={title}
      description={description}
      image={image}
      type={type}
      publishDate={publishDate}
    />
  </head>
  <body class="min-h-screen font-sans antialiased">
    <header class="border-b border-gray-200 bg-white">
      <nav class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4">
        <a href="/" class="text-xl font-bold text-gray-900">ТВІЙ-САЙТ</a>
        <div class="flex items-center gap-6 text-sm font-medium text-gray-600">
          <a href="/" class="hover:text-amber-600 transition-colors">Home</a>
          <a href="/about" class="hover:text-amber-600 transition-colors">About</a>
          <a href="/contact" class="hover:text-amber-600 transition-colors">Contact</a>
        </div>
      </nav>
    </header>

    <main class="mx-auto max-w-4xl px-4 py-8">
      <slot />
    </main>

    <AffiliateDisclosure />

    <footer class="border-t border-gray-200 bg-gray-50 py-8 text-center text-sm text-gray-500">
      <div class="mx-auto max-w-4xl px-4">
        <p>&copy; {new Date().getFullYear()} ТВІЙ-САЙТ. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
