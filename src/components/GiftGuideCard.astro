---
interface Props {
  name: string;
  image: string;
  priceRange: '$' | '$$' | '$$$';
  perfectFor: string;
  link: string;
  isOwnProduct: boolean;
  platform?: 'amazon' | 'sovrn' | 'sharesale' | 'direct';
}

const { name, image, priceRange, perfectFor, link, isOwnProduct, platform } = Astro.props;
const isAffiliateEnabled = import.meta.env.ENABLE_AMAZON_AFFILIATE === 'true';

const href = isOwnProduct || !isAffiliateEnabled || platform !== 'amazon'
  ? link
  : link.includes('?') ? `${link}&tag=ТВІЙ-ТЕГ-ТУТ` : `${link}?tag=ТВІЙ-ТЕГ-ТУТ`;
---

<div class="gift-card rounded-2xl border border-gray-200 bg-white p-4 shadow-sm transition-shadow hover:shadow-md">
  <img
    src={image}
    alt={name}
    loading="lazy"
    class="w-full rounded-xl object-cover aspect-pin"
  />
  <div class="mt-3">
    <h4 class="font-semibold text-gray-900">{name}</h4>
    <div class="mt-1 flex items-center gap-2">
      <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">{priceRange}</span>
      <span class="text-xs text-amber-700">🎯 {perfectFor}</span>
    </div>
    <a
      href={href}
      class={isOwnProduct ? 'cta-own mt-3 text-xs' : 'cta-affiliate mt-3 text-xs'}
      target="_blank"
      rel={isOwnProduct ? 'noopener' : 'nofollow sponsored'}
    >
      {isOwnProduct ? 'Shop Lamamarka →' : 'Check Price →'}
    </a>
  </div>
</div>
