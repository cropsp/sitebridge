---
interface Product {
  name: string;
  image: string;
  isOwnProduct: boolean;
  pros: string[];
  cons: string[];
  priceRange: '$' | '$$' | '$$$';
  link: string;
  verdict: string;
  platform?: 'amazon' | 'sovrn' | 'sharesale' | 'direct';
}

interface Props {
  title: string;
  products: Product[];
}

const { title, products } = Astro.props;
const isAffiliateEnabled = import.meta.env.ENABLE_AMAZON_AFFILIATE === 'true';

function affiliateHref(link: string, isOwn: boolean, platform?: string): string {
  if (isOwn || !isAffiliateEnabled || platform !== 'amazon') return link;
  return link.includes('?') ? `${link}&tag=ТВІЙ-ТЕГ-ТУТ` : `${link}?tag=ТВІЙ-ТЕГ-ТУТ`;
}

const heroPick = products.find(p => p.isOwnProduct);
const hasOwnProduct = products.some(p => p.isOwnProduct);
---

<div class="comparison-table">
  <h2 class="text-2xl font-bold text-gray-900">{title}</h2>
  <div class="mt-6 space-y-4">
    {products.map((p) => (
      <div class="product-row flex flex-col sm:flex-row gap-4 rounded-xl border border-gray-200 bg-white p-4">
        <img
          src={p.image}
          alt={p.name}
          class="h-32 w-32 shrink-0 rounded-lg object-cover"
          loading="lazy"
        />
        <div class="flex-1 min-w-0">
          <h3 class="text-lg font-semibold text-gray-900">{p.name}</h3>
          <span class="inline-block mt-1 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800">{p.verdict}</span>
          <span class="ml-2 text-sm text-gray-500">{p.priceRange}</span>

          <ul class="mt-2 space-y-0.5">
            {p.pros.map(pr => <li class="text-sm text-green-700">✅ {pr}</li>)}
          </ul>
          <ul class="mt-1 space-y-0.5">
            {p.cons.map(c => <li class="text-sm text-red-600">❌ {c}</li>)}
          </ul>

          <a
            href={affiliateHref(p.link, p.isOwnProduct, p.platform)}
            class={p.isOwnProduct ? 'cta-own mt-3' : 'cta-affiliate mt-3'}
            target="_blank"
            rel={p.isOwnProduct ? 'noopener' : 'nofollow noopener sponsored'}
          >
            {p.isOwnProduct ? 'Shop Lamamarka →' : 'Check Price →'}
          </a>
        </div>
      </div>
    ))}
  </div>
  {hasOwnProduct && heroPick && (
    <div class="verdict-row mt-6 rounded-xl bg-amber-50 border border-amber-200 p-4 text-center">
      <strong class="text-lg">🏆 Our Pick:</strong>{' '}
      <span class="font-semibold text-amber-900">{heroPick.name}</span>
      <span class="ml-2 text-sm text-amber-700">— {heroPick.verdict}</span>
    </div>
  )}
</div>
