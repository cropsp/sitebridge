---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailCapture from '../components/EmailCapture.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const latest = posts
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 6);
---

<BaseLayout
  title="ТВІЙ-САЙТ — Serious Gifts, Unserious Ideas"
  description="Honest gift guides for men who have everything. EDC gear, funny gifts, and handcrafted leather from Lamamarka."
  type="product"
>

<!-- Hero -->
<section class="mb-16 text-center">
  <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl text-balance">
    Serious Gifts,<br />Unserious Ideas
  </h1>
  <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto text-balance">
    Honest gift guides for the men in your life. From handcrafted EDC gear to
    the perfect gag gift — we test, compare, and recommend without the fluff.
  </p>
  <div class="mt-8 flex justify-center gap-4">
    <a href="#guides" class="cta-own text-base px-6 py-3">Browse Gift Guides →</a>
    <a href="/about" class="cta-affiliate text-base px-6 py-3">How We Pick</a>
  </div>
</section>

<!-- Featured Lamamarka Product -->
<section class="mb-16 rounded-2xl bg-amber-50 border border-amber-200 p-8">
  <div class="flex flex-col md:flex-row items-center gap-8">
    <div class="flex-1 text-center md:text-left">
      <span class="inline-block rounded-full bg-amber-200 px-3 py-1 text-xs font-semibold text-amber-900">🏆 Our Brand</span>
      <h2 class="mt-3 text-3xl font-bold text-gray-900">Lamamarka Leather Goods</h2>
      <p class="mt-3 text-gray-700">
        Hand-stitched, full-grain leather accessories built to last. Every piece
        is designed to be useful, look better with age, and start conversations.
      </p>
      <a href="https://lamamarka.com" class="cta-own mt-4 text-base px-6 py-3" target="_blank" rel="noopener">
        Shop Lamamarka →
      </a>
    </div>
    <div class="flex-1 flex justify-center">
      <div class="w-48 h-48 rounded-xl bg-amber-200 flex items-center justify-center text-amber-700 text-sm">
        👜 Product Image
      </div>
    </div>
  </div>
</section>

<!-- Latest Guides -->
<section id="guides" class="mb-16">
  <h2 class="text-2xl font-bold text-gray-900 mb-6">Latest Guides</h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {latest.map((post) => (
      <a
        href={`/blog/${post.id.replace(/\.mdx?$/, '')}/`}
        class="group rounded-2xl border border-gray-200 bg-white p-4 shadow-sm transition-shadow hover:shadow-md"
      >
        <div class="w-full h-40 rounded-xl bg-gray-100 flex items-center justify-center text-gray-400 text-sm overflow-hidden">
          {post.data.heroImage?.src ? (
            <img
              src={post.data.heroImage.src}
              alt={post.data.heroImage.alt}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          ) : (
            <span>2:3 Image</span>
          )}
        </div>
        <div class="mt-3">
          <span class="inline-block rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600 mb-1">
            {post.data.category}
          </span>
          <h3 class="font-semibold text-gray-900 group-hover:text-amber-700 transition-colors">
            {post.data.title}
          </h3>
          <p class="mt-1 text-sm text-gray-500 line-clamp-2">{post.data.description}</p>
          <span class="inline-block cta-affiliate mt-3 text-xs">
            Read Guide →
          </span>
        </div>
      </a>
    ))}
  </div>
</section>

<!-- Seen on Pinterest -->
<section class="mb-16 rounded-2xl bg-red-50 border border-red-200 p-8 text-center">
  <h2 class="text-2xl font-bold text-gray-900">📌 Seen on Pinterest</h2>
  <p class="mt-2 text-gray-600">
    Our gift guides are saved thousands of times. Join the community that finds
    genuinely great gifts through pins that don't disappoint.
  </p>
  <div class="mt-6 flex justify-center gap-4 flex-wrap">
    <div class="w-32 h-48 rounded-lg bg-red-100 flex items-center justify-center text-red-400 text-xs">Pin 1</div>
    <div class="w-32 h-48 rounded-lg bg-red-100 flex items-center justify-center text-red-400 text-xs">Pin 2</div>
    <div class="w-32 h-48 rounded-lg bg-red-100 flex items-center justify-center text-red-400 text-xs">Pin 3</div>
  </div>
</section>

<!-- Email Capture -->
<EmailCapture
  title="Never Miss a Gift Guide"
  description="Weekly gift ideas, no spam. Unsubscribe anytime."
/>

</BaseLayout>
